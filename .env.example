# Copy to .env and fill in. Never commit .env.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# QLOO_MODE=mock          # force the offline mock (default: live when QLOO_API_KEY is set)
# QLOO_REQ_PER_SEC=4      # stay under the documented 10 requests/second
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# SEAL_PASSWORD=          # encrypts the private seal files
# WIKIMEDIA_CONTACT=      # optional contact (URL or email) added to the Wikimedia User-Agent
# PORT=3000
# SLEEPERHIT_TODAY=2026-10-22   # pin "today" for demos
